venv/
.venv/
__pycache__/
*.pyc
*.log
.claude/
# GitHub CLI login kept inside gujincheng (the server account is shared); never commit it
.gh_config/
# fresh exports built for the private GitHub copy (review-ai/tools/export_for_github.sh)
github_export/
# run logs; only the checksum of the follow-up pre-registration is kept
review-ai/logs/*
!review-ai/logs/followup/
review-ai/logs/followup/*
!review-ai/logs/followup/plan_sha256_at_launch.txt

